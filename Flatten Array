const arr = [1, [2, 3], [4, [5, 6]]];

function flattenArray(arr,newarr=[]){
    for(let i=0;i<arr.length;i++){
        if(Array.isArray(arr[i])){
           newarr= newarr.concat(flattenArray(arr[i]))
        }else{
            newarr.push(arr[i])
        }
    }
    return newarr
}

console.log(flattenArray(arr))
